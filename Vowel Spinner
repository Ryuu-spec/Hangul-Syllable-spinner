<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Hangul Syllable Spinner</title>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;700;900&display=swap" rel="stylesheet">
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html, body {
    font-family: 'Noto Sans KR', sans-serif;
    background: #ffffff;
    width: 100%;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
  }
  :root {
    --lime: #97C459;
    --lime-dark: #639922;
    --orange: #EF9F27;
    --orange-dark: #BA7517;
  }
  .card {
    background: #fff;
    border-radius: 20px;
    padding: 1.4rem 1.2rem 1.2rem;
    width: 100%;
    max-width: 360px;
    text-align: center;
  }
  .card.consonant-mode { border: 3px solid var(--lime); }
  .card.consonant-mode .title { color: var(--lime-dark); }
  .card.consonant-mode .fixed-char { color: var(--lime); }
  .card.consonant-mode .spin-char { color: var(--orange); }
  .card.consonant-mode .spin-btn { background: var(--lime); }
  .card.consonant-mode .spin-btn:hover { background: var(--lime-dark); }
  .card.vowel-mode { border: 3px solid var(--orange); }
  .card.vowel-mode .title { color: var(--orange-dark); }
  .card.vowel-mode .fixed-char { color: var(--orange); }
  .card.vowel-mode .spin-char { color: var(--lime); }
  .card.vowel-mode .spin-btn { background: var(--orange); }
  .card.vowel-mode .spin-btn:hover { background: var(--orange-dark); }
  .title {
    font-size: 16px;
    font-weight: 700;
    margin-bottom: 1rem;
  }
  .combo-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-bottom: 0.8rem;
  }
  .char-box {
    width: 90px;
    height: 90px;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 56px;
    font-weight: 900;
    background: #f8f8f8;
    border: 2px solid #eee;
  }
  .spin-char.spinning {
    animation: spinFlip 0.08s ease infinite alternate;
  }
  .spin-char.done {
    animation: popIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }
  @keyframes spinFlip {
    0% { transform: scaleY(1); opacity: 1; }
    100% { transform: scaleY(0.6); opacity: 0.7; }
  }
  @keyframes popIn {
    0% { transform: scale(0.5); opacity: 0; }
    100% { transform: scale(1); opacity: 1; }
  }
  .operator {
    font-size: 24px;
    color: #ccc;
    font-weight: 700;
  }
  .hint {
    font-size: 12px;
    color: #bbb;
    margin: 0.6rem 0 1rem;
    line-height: 1.5;
  }
  .spin-btn {
    color: white;
    border: none;
    padding: 11px 48px;
    font-size: 15px;
    font-weight: 700;
    font-family: 'Noto Sans KR', sans-serif;
    border-radius: 50px;
    cursor: pointer;
    transition: background 0.2s, transform 0.15s;
    letter-spacing: 1px;
  }
  .spin-btn:active { transform: scale(0.97); }
  .spin-btn:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }
</style>
</head>
<body>
<div class="card" id="card">
  <div class="title" id="title">Hangul Syllable Spinner</div>
  <div class="combo-row" id="comboRow"></div>
  <p class="hint" id="hint">Combine and read it aloud!</p>
  <button class="spin-btn" id="btn" onclick="spin()">SPIN</button>
</div>
<script>
const VOWELS     = ['ㅏ','ㅐ','ㅑ','ㅓ','ㅔ','ㅕ','ㅗ','ㅛ','ㅜ','ㅠ','ㅡ','ㅣ'];
const CONSONANTS = ['ㄱ','ㄲ','ㄴ','ㄷ','ㄸ','ㄹ','ㅁ','ㅂ','ㅃ','ㅅ','ㅆ','ㅇ','ㅈ','ㅉ','ㅊ','ㅋ','ㅌ','ㅍ','ㅎ'];

const params    = new URLSearchParams(location.search);
const fixedChar = params.get('char') || '';
const type      = params.get('type') || 'vowel';
// type=vowel    : 자음 칸 밟음 → 자음 고정(연두) + 모음 랜덤(주황)
// type=consonant: 모음 칸 밟음 → 모음 고정(주황) + 자음 랜덤(연두)

const card    = document.getElementById('card');
const titleEl = document.getElementById('title');
const hintEl  = document.getElementById('hint');
const row     = document.getElementById('comboRow');

if (type === 'vowel') {
  card.classList.add('consonant-mode');
  titleEl.textContent = 'Hangul Vowel Picker';
  hintEl.textContent  = 'Combine with the consonant you landed on and read it aloud!';
  row.innerHTML = `
    <div class="char-box fixed-char" id="fixedBox">${fixedChar || 'ㄱ'}</div>
    <div class="operator">+</div>
    <div class="char-box spin-char" id="spinBox">?</div>`;
} else {
  card.classList.add('vowel-mode');
  titleEl.textContent = 'Hangul Consonant Picker';
  hintEl.textContent  = 'Combine with the vowel you landed on and read it aloud!';
  row.innerHTML = `
    <div class="char-box spin-char" id="spinBox">?</div>
    <div class="operator">+</div>
    <div class="char-box fixed-char" id="fixedBox">${fixedChar || 'ㅏ'}</div>`;
}

const actx = new (window.AudioContext || window.webkitAudioContext)();
function playClick() {
  const o = actx.createOscillator(), g = actx.createGain();
  o.connect(g); g.connect(actx.destination);
  o.frequency.value = 600; o.type = 'square';
  g.gain.setValueAtTime(0.06, actx.currentTime);
  g.gain.exponentialRampToValueAtTime(0.001, actx.currentTime + 0.04);
  o.start(actx.currentTime); o.stop(actx.currentTime + 0.04);
}
function playChime() {
  [523,659,784].forEach((freq,i) => {
    const o = actx.createOscillator(), g = actx.createGain();
    o.connect(g); g.connect(actx.destination);
    o.frequency.value = freq; o.type = 'sine';
    const t = actx.currentTime + i * 0.12;
    g.gain.setValueAtTime(0.12, t);
    g.gain.exponentialRampToValueAtTime(0.001, t + 0.4);
    o.start(t); o.stop(t + 0.4);
  });
}
function rand(arr) { return arr[Math.floor(Math.random() * arr.length)]; }

let spinning = false;
function spin() {
  if (spinning) return;
  spinning = true;
  const btn     = document.getElementById('btn');
  const spinBox = document.getElementById('spinBox');
  btn.disabled  = true;
  spinBox.className = 'char-box spin-char';
  const pool = type === 'vowel' ? VOWELS : CONSONANTS;
  let count = 0;
  const total = 20;
  const interval = setInterval(() => {
    spinBox.textContent   = rand(pool);
    spinBox.className = 'char-box spin-char spinning';
    playClick();
    count++;
    if (count >= total) {
      clearInterval(interval);
      spinBox.textContent = rand(pool);
      spinBox.className   = 'char-box spin-char done';
      playChime();
      btn.disabled = false;
      spinning     = false;
    }
  }, 70);
}
</script>
</body>
</html>
